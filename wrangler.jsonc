// Cloudflare の設定（書類サイト＋利用回数カウンター）
{
  "name": "syorui4",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "syorui4-count",
      "database_id": "3e3349a4-3fad-46b0-9bd5-8175498b4499"
    }
  ]
}
